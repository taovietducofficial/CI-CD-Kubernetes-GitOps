{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicas", "resources", "canary"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-z][0-9a-z._-]{0,127}$",
          "description": "Git SHA of the build"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "description": "Image manifest digest; required by admission policy in workload namespaces"
        }
      }
    },
    "replicas": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "canary": {
      "type": "object",
      "required": ["steps"],
      "properties": { "steps": { "type": "array", "minItems": 1 } }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "successRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "prometheusAddress": { "type": "string", "format": "uri" }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "slo": {
      "type": "object",
      "properties": {
        "availabilityTarget": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "latencyP99Seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sealedSecrets": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
